{
  "name": "freelance-escrow-backend",
  "version": "1.0.0",
  "description": "ISA-II: REST API for a Freelance Project & Client Escrow platform (Node.js, Express, Sequelize, MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/createDb.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "node scripts/seed.js",
    "setup": "npm run db:create && npm run migrate && npm run seed",
    "setup:sync": "npm run db:create && node scripts/seed.js --reset",
    "smoke": "node tests/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  }
}
